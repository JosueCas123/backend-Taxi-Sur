# ============================================
# Variables de entorno — Backend Radio Taxi MVP
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el .env real a git.
# ============================================

# Base de datos PostgreSQL
# Ejemplo local:        postgresql://postgres:postgres@localhost:5432/radiotaxi
# Ejemplo Railway/Neon: lo obtienes del dashboard del proveedor
DATABASE_PASSWORD=XXXX
DATABASE_URL=XXXX   

TEST_DATABASE_URL=XXXX
# De referencia: la suite usa TEST_DATABASE_URL y nunca sustituye esta contraseña en la URL.
TEST_DATABASE_PASSWORD=XXXX

# Puerto del servidor Express
PORT=3000

# Entorno
NODE_ENV=development

# JWT para autenticación del admin (dashboard)
JWT_SECRET="cambia_esto_por_un_secreto_largo_y_aleatorio"
JWT_EXPIRES_IN="8h"

# Token compartido entre n8n y el backend
# n8n debe enviar este token en cada request para que la API confíe en él
N8N_API_TOKEN="cambia_esto_por_otro_secreto"

# Primer administrador (los usa solo `npm run admin:create`, con valores reales)
# No se ejecutan al iniciar el servidor. NUNCA dejes placeholders reales en git.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambia_esto_por_una_contrasena_del_administrador
ADMIN_PHONE=+59170000000

# Proveedor de WhatsApp (usado dentro de n8n, no directamente en el backend,
# pero lo dejamos documentado aquí para referencia del equipo)
# WHATSAPP_PROVIDER=meta-cloud-api | twilio | evolution-api
